# .env.example
# Copy this file to .env and fill in your keys

# Hugging Face Token (Required for MedGemma)
# Get it at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Google Gemini API Key (Optional Fallback for local dev)
# Get it at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here

# App Settings
PORT=8001
USE_LOCAL_MODEL=False # Set to True to load MedGemma locally (needs 4GB+ VRAM)
